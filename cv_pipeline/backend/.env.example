# ============================================================
#  CV Pipeline - configuration
#  Copy this file to ".env" and fill in your values.
#  NEVER commit the real .env file to git.
# ============================================================

# ---------- LLM ----------
# Which LLM to use by default: "claude" or "gemini"
# (can be overridden per run with:  python main.py extract --provider gemini)
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# How resumes are parsed:
#   llm     = the LLM reads the resume itself: PDF/image files are sent directly to
#             Claude/Gemini, DOCX text is sent as text. No extra models. (default)
#   docling = convert with Docling first (needs: pip install -r requirements-docling.txt)
CV_PARSER=llm
# Only used when CV_PARSER=docling: OCR for scanned PDFs/images (true/false)
DOCLING_OCR=true

# ---------- Mail (IMAP) ----------
# Zoho (India accounts usually imap.zoho.in, global imap.zoho.com,
#       paid org accounts imappro.zoho.in / imappro.zoho.com)
# Gmail: imap.gmail.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.email@gmail.com
# Use an APP PASSWORD (not your normal login password) if 2FA is on
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# Mail folder to scan. Gmail: "INBOX" or "[Gmail]/All Mail"; Zoho: "INBOX"
IMAP_FOLDER=INBOX

# Only on the FIRST run (no saved state yet): ignore mails older than this date (YYYY-MM-DD).
# Leave empty to scan the whole folder on the first run.
FETCH_SINCE_DATE=2026-09-01

# Optional filters (comma separated, case-insensitive). Leave empty = no filter.
# A mail is kept if its subject contains ANY of these words
SUBJECT_KEYWORDS=
# A mail is kept if the sender address contains ANY of these
FROM_FILTER=

# Max attachment size to save (MB)
MAX_ATTACHMENT_MB=15

# ---------- Paths ----------
CV_FOLDER=data/cvs
OUTPUT_EXCEL=data/output/candidates.xlsx
STATE_FOLDER=data/state
JOBS_FOLDER=data/jobs

# ---------- Job fit (Step 4) ----------
# How many candidates to score in parallel (LLM calls). Lower it if you hit rate limits.
JOBFIT_WORKERS=3
