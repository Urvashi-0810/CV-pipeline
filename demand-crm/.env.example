# Copy to .env and adjust. Values here are for local development only.

# Running the API outside Docker? Point this at your local PostgreSQL.
# (docker compose overrides it to use the "db" container.)
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
TEST_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_test

# Must be true in production (HTTPS). false only for http://localhost.
COOKIE_SECURE=false

SESSION_TTL_HOURS=12
ADMIN_SESSION_MINUTES=30
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=6

# Where uploaded and generated files are kept (one folder per demand).
# Relative to the backend folder when running without Docker (Docker sets its own path).
STORAGE_ROOT=../storage

# REQUIRED for AI settings: encrypts the LLM API keys stored in the database.
# Generate:  docker compose run --rm api python -m scripts.generate_secret_key
#   (or, without Docker: python -m scripts.generate_secret_key)
# Keep it safe and never change it casually: stored API keys can't be read without it.
APP_SECRET_KEY=

# Upload limits (a clear "file too large" message above these).
MAX_FILE_MB=10
MAX_LETTER_INPUTS_MB=20
MAX_IMAGES_PER_LETTER=20

# Worker
WORKER_CONCURRENCY=10
JOB_LEASE_SECONDS=300

# DEVELOPMENT ONLY: adds a "Test — no AI" provider that returns canned letters, so the
# flow can be tried without an API key. Keep false on the client's server.
LLM_ALLOW_TEST_PROVIDER=false

# Full path to LibreOffice's soffice, only if it isn't found automatically.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
